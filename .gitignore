# Byte-compiled / optimized / compiled
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
dist/
dist_new/
build/
*.egg-info/

# Virtual environment
.venv/
venv/
env/

# PyInstaller
*.manifest
# spec 是构建配置（hiddenimports / datas / upx_exclude），不是产物 —— 要跟踪
*.spec
!spectra.spec

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local config
.env
.local

# Cached FFTW wisdom
*.pkl

# Demo assets（只忽略根目录散图；assets/ 里是运行时要读的资源）
/*.png
/*.jpg
/*.jpeg
/*.gif
!assets/*.png

# Temporary files
*.tmp
*.log
/release-check/
.claude/worktrees/

# 参考材料堆（非代码，不进仓库）
/_remote_ref/
